LANG_STRING(WizardFormEmulationType, WizardFormEmulationType, 50105, "WizardForm", "EmulationType", "Emulation type")
LANG_STRING(WizardFormEmulationTypeDOSBox, WizardFormEmulationTypeDOSBox, 50106, "WizardForm", "EmulationType.DOSBox", "DOSBox (allows you to run any DOS program)")
LANG_STRING(WizardFormEmulationTypeScummVM, WizardFormEmulationTypeScummVM, 50107, "WizardForm", "EmulationType.ScummVM", "Scumm based adventure game")
LANG_STRING(WizardFormEmulationTypeListScummVMGames, WizardFormEmulationTypeListScummVMGames, 50108, "WizardForm", "EmulationType.ListScummVMGames", "List of supported Scumm games")
LANG_STRING(WizardFormEmulationTypeWindows, WizardFormEmulationTypeWindows, 50109, "WizardForm", "EmulationType.Windows", "Windows game")
LANG_STRING(WizardFormGamesFolder, WizardFormGamesFolder, 50110, "WizardForm", "GamesFolder", "Recommend parent directory for the game directory")
LANG_STRING(WizardFormGamesFolderInfo, WizardFormGamesFolderInfo, 50111, "WizardForm", "GamesFolder.Info", "You can place the games you want to use with D-Fend Reborn in any directory, but if you put them in a subdirectory of %s D-Fend Reborn will be able to store the paths as relative paths. Only with relative paths you can use the \"Build installer\" and \"Transfer games\" functions from the \"Extras\" menu.")
LANG_STRING(WizardFormBaseDataFolderInfo, WizardFormBaseDataFolderInfo, 50112, "WizardForm", "BaseDataFolder.Info", "You can place the games' data files (manuals etc.) in any directory. But if you put them in a subdirectory of %s D-Fend Reborn will be able to store the paths as relative paths. Only with relative paths you can use the \"Build installer\" and \"Transfer games\" functions from the \"Extras\" menu.")
