LANG_STRING(WizardForm, WizardForm, 50001, "WizardForm", "Caption", "Create new profile")
LANG_STRING(WizardFormButtonPrevious, WizardFormButtonPrevious, 50002, "WizardForm", "Button.Previous", "Previous")
LANG_STRING(WizardFormButtonNext, WizardFormButtonNext, 50003, "WizardForm", "Button.Next", "Next")
LANG_STRING(WizardFormMainInfo, WizardFormMainInfo, 50004, "WizardForm", "MainInfo", "Information about the D-Fend Reborn file structure")
LANG_STRING(WizardFormMainInfo1, WizardFormMainInfo1, 50005, "WizardForm", "MainInfoPart1", "D-Fend Reborn is 100% Windows Vista and 7 compatible. This means it respects the division of the program data into program files and user data. If you have installed D-Fend Reborn in \"user profile mode\", the program files are located in the program files folder (\"C:\\Program files\\D-Fend Reborn\" by default) and the user data files are located in a subfolder of the user profile directory (\"C:\\Users\\<you>\\D-Fend Reborn\" by default). When D-Fend Reborn is running it will not write to the program folder anymore. All setup data is stored in the user profile subfolder.")
LANG_STRING(WizardFormMainInfo2, WizardFormMainInfo2, 50006, "WizardForm", "MainInfoPart2", "DOSBox and Windows do not use the same directory structures. The programs inside DOSBox only see a subset of the whole Windows directory structure. This implies that the games running in DOSBox cannot damage your system files (unless you setup DOSBox to use your real \"C:\\\" as drive C: in DOSBox). In most cases you want to mount a folder like \"C:\\OldGames\" as drive C: in DOSBox. This means that, if you store a game in \"C:\\OldGames\\Somegame\", you can access this game in DOSBox via \"C:\\Somegame\", but you do not need to worry about mounting drives at all because D-Fend Reborn is mounting the right folders automatically for you.")
LANG_STRING(WizardFormMainInfo3, WizardFormMainInfo3, 50007, "WizardForm", "MainInfoPart3", "You can store your game wherever you want, but it is recommended to use the predefined games directory (\"C:\\Users\\<you>\\D-Fend Reborn\\VirtualHD\"). If you use this directory for your games, D-Fend Reborn can use relative paths in the profile (\".\\VirtualHD\\NewGame\" instead of \"C:\\Users\\<you>\\D-Fend Reborn\\VirtualHD\\NewGame\"). If D-Fend Reborn knows where the games' files are located relative to the program data directory, it can transfer the games' files to another installation or it can make installer packages for you. This isn't possible with absolute pathes.")
LANG_STRING(WizardFormPage1Info, WizardFormPage1Info, 50008, "WizardForm", "Page1Info", "Please choose the type of profile you want to create.")
LANG_STRING(WizardFormPage2Info, WizardFormPage2Info, 50009, "WizardForm", "Page2Info", "Please setup where the game or program file you want to start is located. If you choose a subfolder of the given directory for the files, D-Fend Reborn will be able to use relative paths.")
LANG_STRING(WizardFormPage2InfoWindows, WizardFormPage2InfoWindows, 50010, "WizardForm", "Page2InfoWindows", "Please setup where the game or program file you want to start is located.")
LANG_STRING(WizardFormPage3Info, WizardFormPage3Info, 50011, "WizardForm", "Page3Info", "Please select a template for the new profile.")
LANG_STRING(WizardFormPage4Info, WizardFormPage4Info, 50012, "WizardForm", "Page4Info", "Please define the meta information for the new game or program. All information is optional and can be completed using the profile editor at any time. This means there is no need to fill out all of these fields now, but it is recommended to at least choose a name for the profile.")
LANG_STRING(WizardFormPage5Info, WizardFormPage5Info, 50014, "WizardForm", "Page5Info", "Please check whether the drive mountings created by D-Fend Reborn are correct and then start the profile creation process by clicking on \"Ok\".")
LANG_STRING(WizardFormPage6Info, WizardFormPage6Info, 50015, "WizardForm", "Page6Info", "Please define the ScummVM configuration.")
