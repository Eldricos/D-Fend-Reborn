LANG_STRING(WizardFormBaseDataFolder, WizardFormBaseDataFolder, 50116, "WizardForm", "BaseDataFolder", "Recommended parent directory for the additional data directory")
LANG_STRING(WizardFormDataFolder, WizardFormDataFolder, 50117, "WizardForm", "DataFolder", "Additional data folder (optional)")
LANG_STRING(WizardFormDataFolderButton, WizardFormDataFolderButton, 50118, "WizardForm", "DataFolder.Button", "Setup additional files manually")
LANG_STRING(WizardFormDataFolderCheckbox, WizardFormDataFolderCheckbox, 50119, "WizardForm", "DataFolder.Checkbox", "Setup additional files directory automatically")
LANG_STRING(WizardFormDataFolderAutomaticButton, WizardFormDataFolderAutomaticButton, 50120, "WizardForm", "DataFolder.AutomaticButton", "Choose data folder name from profile name automatically")
LANG_STRING(WizardFormTemplateInfo, WizardFormTemplateInfo, 50201, "WizardForm", "TemplateInfo", "The auto setup templates are a special type of templates. Each auto setup template was created for one special game. D-Fend Reborn tries to find a matching auto setup template for the given game or program file. Therefore it compares a checksum calculated over the real file with the checksums stored in the auto setup templates and compares the real filename with the filenames stored in the auto setup templates.[13][13]If the checksums match for with a particular auto setup template, you should use this template for the new profile because this auto setup template was made exactly for your game or program. You should only use a template that only matches by filename if there is no template that matches by checksum.[13][13]If there is an auto setup template for your game or program, but D-Fend Reborn does not show it in the first two dropdown boxes, then you may have another unrecognized version of the program.[13][13]Alternatively you may use one of the normal templates for the new profile at any time, but if you use a normal template there is no guarantee the game or program will run immediately without any further setup.")
LANG_STRING(WizardFormTemplateType1, WizardFormTemplateType1, 50202, "WizardForm", "TemplateType1", "Use compatible auto setup template (recommended)")
LANG_STRING(WizardFormTemplateType1Info, WizardFormTemplateType1Info, 50203, "WizardForm", "TemplateType1Info", "These templates are made specifically for the selected game. They match with the program file via a checksum comparison.")
LANG_STRING(WizardFormTemplateType2, WizardFormTemplateType2, 50204, "WizardForm", "TemplateType2", "Use auto setup template that only matches by filename")
LANG_STRING(WizardFormTemplateType2Info, WizardFormTemplateType2Info, 50205, "WizardForm", "TemplateType2Info", "These templates match to the given program file by the filename but not by the checksum. May be your game version just differs from the game version the auto setup template was made from.")
LANG_STRING(WizardFormTemplateType3, WizardFormTemplateType3, 50206, "WizardForm", "TemplateType3", "Use user-defined auto setup template")
LANG_STRING(WizardFormTemplateType3Info, WizardFormTemplateType3Info, 50207, "WizardForm", "TemplateType3Info", "In this list you can find all available auto setup templates. If you are sure your new game is in this list, you can choose the corresponding auto setup template.")
LANG_STRING(WizardFormTemplateType4, WizardFormTemplateType4, 50208, "WizardForm", "TemplateType4", "Use user-defined template")
LANG_STRING(WizardFormTemplateType4Info, WizardFormTemplateType4Info, 50209, "WizardForm", "TemplateType4Info", "In this list you will find all normal user-defined templates. You can use any of these templates for new profiles at any time, but these templates do not contain any settings tailored for a specific game.")
LANG_STRING(WizardFormTemplateType5, WizardFormTemplateType5, 50210, "WizardForm", "TemplateType5", "Use default wizard template")
